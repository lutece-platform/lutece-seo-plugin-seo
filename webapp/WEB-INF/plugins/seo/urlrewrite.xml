<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE urlrewrite PUBLIC "-//tuckey.org//DTD UrlRewrite 4.0//EN" "http://www.tuckey.org/res/dtds/urlrewrite4.0.dtd">
<!--

    Configuration file for UrlRewriteFilter
    http://tuckey.org/urlrewrite/

    Initial content, mirroring what RuleFileService generates from the data
    seeded by sql/plugins/seo/plugin/init_db_seo.sql. Regenerated from the
    back office (SEO management) - manual changes are lost at generation.

-->
<urlrewrite>
        <rule>
            <from>^/page/([0-9]+)</from>
            <to>/jsp/site/Portal.jsp?page_id=$1</to>
        </rule>
        <rule>
            <from>^/app/([a-z]+)</from>
            <to>/jsp/site/Portal.jsp?page=$1</to>
        </rule>
        <rule>
            <from>^/map</from>
            <to>/jsp/site/Portal.jsp?page=map</to>
        </rule>
        <rule>
            <from>^/sitemap.html$</from>
            <to>/jsp/site/Portal.jsp?page=map</to>
        </rule>
        <rule>
            <from>^/contacts.html$</from>
            <to>/jsp/site/Portal.jsp?page=contact</to>
        </rule>
        <rule>
            <from>^/credits.html$</from>
            <to>/jsp/site/PopupCredits.jsp</to>
        </rule>
</urlrewrite>
