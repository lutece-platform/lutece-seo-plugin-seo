<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE urlrewrite PUBLIC "-//tuckey.org//DTD UrlRewrite 4.0//EN" "http://www.tuckey.org/res/dtds/urlrewrite4.0.dtd">
<!--

    Configuration file for UrlRewriteFilter
    http://tuckey.org/urlrewrite/

    GENERATED FILE - do not edit by hand.
    Produced by fr.paris.lutece.plugins.seo.service.RuleFileService from the
    URL rewriter rules (seo_rule) and the friendly URLs (seo_friendly_url).
    Any manual change is lost at the next generation.

-->
<#-- Rendered with the HTML output format the core gives to a .xml template: its escaping (&lt; &gt; &amp; &quot; &#39;) is valid XML. -->
<urlrewrite>
    <!-- Sitemap generated outside the webapp : served by SitemapServlet -->
    <rule>
        <from>^/sitemap-seo\.xml$</from>
        <to>/servlet/plugins/seo/sitemap-seo.xml</to>
    </rule>
    <#-- The friendly URLs match a whole URL: they come before the rules, which match the start of the URL (the rule /map must not take /mapping.html) -->
    <#list url_list as url>
        <rule>
            <from>^${url.friendlyUrl}$</from>
            <to>${url.technicalUrl}</to>
        </rule>
    </#list>
    <#list rules_list as rule>
        <rule>
            <from>^${rule.ruleFrom}</from>
            <to>${rule.ruleTo}</to>
        </rule>
    </#list>
</urlrewrite>
